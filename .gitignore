# A filled-in compose file carries the gateway access code and your real
# hostnames. The copy tracked in git holds only placeholders; keep any deployed
# copy out of the repository.
docker-compose.override.yml
docker-compose.deploy.yml
docker-compose.local.yml

# Not used by this project, but cheap insurance against one appearing.
.env
*.env

# Runtime state (reboot history, rate-limit timestamps)
data/
state.json
*.tmp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
