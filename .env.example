# Copy to .env next to docker-compose.yml. .env is gitignored; this file is not.
#
# The device access code is printed on the label on the side of the BGW320.
# It is the only secret this project needs.
BGW_ACCESS_CODE=

# Host port the health endpoint is published on, for nginx to proxy to.
# Defaults to 8080. Change it here rather than editing docker-compose.yml.
# WATCHDOG_HOST_PORT=8080

# Optional. Enables the /status endpoint, which returns reboot history and the
# current verdict. Leave unset to keep /status returning 404 -- it is reachable
# from the public internet through the same reverse proxy as /healthz.
# WATCHDOG_STATUS_TOKEN=
